# ─── Database ────────────────────────────────────────────────────────────────
# Neon Postgres serverless connection string
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=

# Admin bootstrap
ADMIN_SECRET=
# Comma-separated emails that always have admin access
ADMIN_EMAILS=

# ─── Stripe (OhPlaces billing + platform fee) ────────────────────────────────
# Secret key from Stripe Dashboard > Developers > API keys
STRIPE_SECRET_KEY=sk_live_...
# Webhook signing secret from Stripe Dashboard > Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Cal.com (slot management + booking reservation) ─────────────────────────
# API key from Cal.com Dashboard > Settings > API keys
CAL_API_KEY=

# ─── Twilio (SMS confirmation + reminders) ───────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+61200000000

# ─── Vercel Cron (reminder job auth) ─────────────────────────────────────────
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ─── File Storage (Vercel Blob) ───────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ─── Frontend ────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:5000
